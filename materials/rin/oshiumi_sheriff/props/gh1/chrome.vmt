"VertexlitGeneric"
{
	"$basetexture" "photon/common/white"
	"$bumpmap" "photon/common/flat"
   	"$nocull" "1"
	
	"$phong" "1"
	"$phongexponent" "10"
	"$phongboost" "2"	
	"$phongfresnelranges"	"[0 1 5]"
	
	"$envmap" env_cubemap
